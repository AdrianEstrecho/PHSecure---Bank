{
  "name": "phsecure-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --quiet --watch . --watch .env --ext js,json --ignore dev-outbox/ --ignore scripts/ --ignore prisma/ --exec \"node --env-file-if-exists=.env index.js\"",
    "start": "node --env-file-if-exists=.env index.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:api": "node --env-file-if-exists=.env scripts/api-smoke-test.mjs"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/server": "^13.3.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  }
}
