PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase: project → Connect. DATABASE_URL = Transaction pooler (port 6543) plus "?pgbouncer=true&connection_limit=1",
# DIRECT_URL = Session pooler (port 5432; the plain "Direct connection" is IPv6-only and unreachable from Vercel builds).
# URL-encode any special characters in the password.
DATABASE_URL=postgresql://postgres.xxxx:pass@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.xxxx:pass@aws-0-region.pooler.supabase.com:5432/postgres

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
# 32-byte hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENC_KEY=

# Leave BREVO_API_KEY empty in development to use the dev outbox (http://localhost:5173/api/dev/outbox).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PHSecure Security
BREVO_SMS_SENDER=PHSecure

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PHSecure Bank
WEBAUTHN_ORIGIN=http://localhost:5173

# Optional "Continue with Google": a Web OAuth client from https://console.cloud.google.com/auth/clients whose
# Authorized redirect URIs include <CLIENT_URL>/api/auth/google/callback (e.g. http://localhost:5173/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# APP_TIMEZONE=Asia/Manila          # time zone used in emails
# TRUST_PROXY=loopback              # Express "trust proxy" setting; use 1 behind a single load balancer
# TRUST_GEO_HEADERS=false           # read city/country from Cloudflare/Vercel headers for email "approximate location"
# CODE_REQUESTS_PER_HOUR=5          # per user, per purpose
# SEED_EMAIL=you@example.com        # inbox for the seeded demo customer
# SEED_PASSWORD=PHSecure-2026
